# Database Connection
ConnectionStrings__Default=Host=localhost;Database=biodiversity;Username=postgres;Password=12345

# Authentication
Jwt__Key=your_super_secret_key_with_at_least_32_chars_long
Jwt__Issuer=iNaturalistLite
Jwt__Audience=iNaturalistLiteUsers

# PlantNet API
PlantNet__ApiKey=your_plantnet_api_key

# Email (Optional, if you want SMTP)
Smtp__Host=smtp.gmail.com
Smtp__Port=587
Smtp__Email=your_email@gmail.com
Smtp__AppPassword=your_app_password
